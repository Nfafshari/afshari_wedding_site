generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BudgetStatus {
  DUE
  DEPOSIT
  PAID
}

enum Attendance {
  PENDING
  ATTENDING
  DECLINED
}

enum PlusOneStatus {
  PENDING
  APPROVED
  REJECTED
}

// One household on the guest list. Exists before anyone responds — the couple
// loads the list ahead of time, and the response fields stay null until a member
// of the party looks it up and submits the form.
model Invitation {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Also the CSV import's upsert key, so re-running an import updates rather than duplicates.
  partyName       String    @unique
  plusOnesAllowed Int       @default(0)

  respondedAt     DateTime?
  respondedByName String?
  email           String?
  phoneNumber     String?
  noteToCouple    String?
  songRequest     String?

  guests          Guest[]
}

model Guest {
  id              Int            @id @default(autoincrement())
  createdAt       DateTime       @default(now())
  name            String
  // normalizeName(name) from src/lib/rsvp.ts — what the public lookup matches against.
  nameKey         String
  attendance      Attendance     @default(PENDING)
  dietary         String?
  // Invited members are created by the couple; plus-ones only by the guest form,
  // and only those carry a plusOneStatus.
  isPlusOne       Boolean        @default(false)
  plusOneStatus   PlusOneStatus?
  invitationId    Int

  // Cascade, unlike RegistryClaim: a guest row means nothing without its invitation.
  invitation      Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([nameKey])
  @@index([invitationId])
}

model RegistryItem {
  id              Int       @id @default(autoincrement())
  createdAt       DateTime  @default(now())
  name            String    @unique
  link            String
  quantityWanted  Int
  // `@default` only applies when the field is omitted on create, never when it is
  // explicitly null — so readers must handle null regardless.
  image           String?   @default("/window.svg")

  claimed         RegistryClaim[]
}

model RegistryClaim {
  id             Int       @id @default(autoincrement())
  claimedBy      String
  quantity       Int
  createdAt      DateTime  @default(now())
  itemId         Int

  // Restrict, not Cascade: Task and BudgetSubcategory cascade because a child is
  // meaningless without its parent, but a claim is a record of a real person who
  // spent real money. Deleting a claimed item is a deliberate two-step chore.
  item           RegistryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // Postgres does not index foreign keys automatically, and every read groups by item.
  @@index([itemId])
}

model BudgetCategory {
  id          Int          @id @default(autoincrement())
  createdAt   DateTime     @default(now())
  order       Int          @default(0)
  name        String       @unique

  budgetSubcategories     BudgetSubcategory[]
}

model BudgetSubcategory {
  id                Int          @id @default(autoincrement())
  createdAt         DateTime     @default(now())
  name              String       
  estimatedCost     Decimal      @db.Decimal(10, 2)
  paidAmount        Decimal      @db.Decimal(10, 2) @default(0)
  status            BudgetStatus @default(DUE)
  budgetCategoryId  Int

  category    BudgetCategory @relation(fields: [budgetCategoryId], references: [id], onDelete: Cascade)
  @@unique([budgetCategoryId, name])
}

model TaskCategory {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  order       Int         @default(0)
  icon        String?    @default("Astroid")
  tasks       Task[]
}

model Task {
  id          Int        @id @default(autoincrement())
  name        String
  createdAt   DateTime   @default(now())
  goalDate    DateTime
  status      Boolean    @default(false)
  categoryId  Int

  category    TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Document {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  name        String     @unique
  companyName String
  icon        String     @default("FileChartColumn")
  // The object's key inside the private Storage bucket, not a URL: links to a
  // private bucket are signed and expire, so they are minted per render instead.
  filePath    String     @unique
}
